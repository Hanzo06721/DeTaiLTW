@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-wrap container"><div class="auth-side"><span class="eyebrow bright">PCStore MEMBER</span><h1>Chào mừng<br/>bạn trở lại.</h1><p>Quản lý hồ sơ, đơn hàng và khám phá cấu hình PC phù hợp với nhu cầu.</p><span class="auth-deco">◈</span></div><div class="auth-form panel"><span class="eyebrow">ACCOUNT</span><h2>Đăng nhập</h2><p>Giao diện tài khoản. Phần xác thực chưa được triển khai.</p><label>Tên đăng nhập<input type="text" placeholder="Nhập tên đăng nhập" disabled /></label><label>Mật khẩu<input type="password" placeholder="Nhập mật khẩu" disabled /></label><button class="btn btn-primary full" disabled>Đăng nhập (chưa kích hoạt)</button><div class="auth-bottom">Chưa có tài khoản? <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a></div></div></div>
