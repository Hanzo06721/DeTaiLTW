@{ ViewData["Title"] = "Đăng ký"; }
<div class="container auth-page"><div class="auth-form panel"><span class="eyebrow">NEW MEMBER</span><h1>Đăng ký tài khoản</h1><p>Khung form tạo tài khoản, chưa lưu dữ liệu.</p><div class="form-grid"><label>Họ và tên<input type="text" placeholder="Nguyễn Văn A" disabled /></label><label>Tên tài khoản<input type="text" placeholder="Tên đăng nhập" disabled /></label><label>Email<input type="email" placeholder="example@email.com" disabled /></label><label>Số điện thoại<input type="tel" placeholder="Số điện thoại" disabled /></label><label>Mật khẩu<input type="password" placeholder="Mật khẩu" disabled /></label><label>Xác nhận mật khẩu<input type="password" placeholder="Nhập lại mật khẩu" disabled /></label></div><button class="btn btn-primary full" disabled>Đăng ký (chưa kích hoạt)</button><div class="auth-bottom">Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập</a></div></div></div>
