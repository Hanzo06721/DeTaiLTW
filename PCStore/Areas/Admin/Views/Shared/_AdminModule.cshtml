@model AdminModuleViewModel
<div class="admin-page-head"><div><div class="eyebrow">MANAGEMENT</div><h1>@Model.Title</h1><p>@Model.Description</p></div><button class="btn btn-primary" disabled>+ Thêm mới (chưa kích hoạt)</button></div>
<div class="module-tip"><span>ⓘ</span><div><strong>Đã tạo khung chức năng</strong><p>@(Model.Reminder ?? "Controller, thư mục View và Model liên quan đã sẵn sàng. Chưa kết nối dữ liệu SQL, chưa có chức năng thêm/sửa/xóa.")</p></div></div>
<div class="admin-card"><div class="admin-card-title"><div><h2>Danh sách @Model.Title.ToLower()</h2><p>Bố cục bảng quản lý, sẽ hiển thị dữ liệu thực khi hoàn thiện module.</p></div><div class="table-actions"><input type="search" aria-label="Tìm kiếm dữ liệu mẫu" placeholder="Tìm kiếm..." disabled /><button type="button" disabled class="btn btn-outline">Lọc ▾</button></div></div><div class="table-wrap"><table class="admin-table"><thead><tr>@foreach (var col in Model.Columns) { <th>@col</th> }</tr></thead><tbody><tr><td colspan="@Model.Columns.Length"><div class="table-empty"><span>@Model.Symbol</span><strong>Chưa có dữ liệu hiển thị</strong><small>Sẽ tải từ SQL Server sau khi hoàn thiện Repository / Service.</small></div></td></tr></tbody></table></div><div class="table-foot">Hiển thị 0 bản ghi <span>Trang 1 / 1</span></div></div>
